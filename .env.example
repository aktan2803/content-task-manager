# Настройки веб-сервера
APP_TITLE="Центр запросов на обновление контента"
HOST=127.0.0.1
PORT=8000

# Пароль для входа в панель администратора (/admin)
ADMIN_PASSWORD=admin123
SECRET_KEY=super-secret-key-change-in-production

# Интеграция с Google Drive
# 1. Положите файл ключа в корень проекта с именем service_account.json
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# 2. Укажите ID папки на Google Диске (из адресной строки браузера)
# Например: https://drive.google.com/drive/folders/1aBcDeFgHiJkLmNoPqRsTuVwXyZ -> 1aBcDeFgHiJkLmNoPqRsTuVwXyZ
GOOGLE_DRIVE_FOLDER_ID=
